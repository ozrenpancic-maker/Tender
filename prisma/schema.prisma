generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Jedan natječaj / postupak javne nabave na kojem korisnik radi
model Project {
  id            String   @id @default(cuid())
  name          String
  authority     String? // naručitelj
  deadline      DateTime?
  notes         String?
  status        String   @default("draft") // draft | analyzing | ready | submitted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents       Document[]
  checklistItems  ChecklistItem[]
  requirements    Requirement[]
  analyses        Analysis[]
  generatedOffers GeneratedOffer[]
  sourceListing   TenderListing?
}

// Dokument koji je korisnik učitao (natječajna dokumentacija ili vlastiti dokument)
model Document {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          String   @default("tender") // tender (dokumentacija natječaja) | own (dokument tvrtke)
  originalName  String
  storedPath    String
  mimeType      String
  extractedText String?
  createdAt     DateTime @default(now())
}

// Stavka checklista - dokument/prilog koji je potrebno pripremiti za ponudu
model ChecklistItem {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String   @default("ostalo") // pravni | financijski | tehnicki | obrazac | ostalo
  mandatory    Boolean  @default(true)
  fulfilled    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Ključni izvučeni zahtjev natječaja (rok, kriterij, vrijednost...)
model Requirement {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  value      String
  createdAt  DateTime @default(now())
}

// Zapis jednog pokretanja AI analize nad dokumentacijom
model Analysis {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary    String
  rawResponse String
  createdAt  DateTime @default(now())
}

// Profil tvrtke ponuditelja (jedan singleton red - aplikacija je jednokorisnička/jedna tvrtka)
model CompanyProfile {
  id           String   @id @default(cuid())
  name         String
  oib          String?
  address      String?
  contactEmail String?
  contactPhone String?
  iban         String?
  description  String? // kratak opis djelatnosti, reference, iskustvo - koristi se u AI nacrtu ponude
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  templates CompanyTemplate[]
}

// Vlastiti predložak tvrtke (npr. obrazac ponude, troškovnik) koji AI koristi kao referencu pri sastavljanju nacrta
model CompanyTemplate {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  title            String
  originalName     String
  storedPath       String
  mimeType         String
  extractedText    String?
  createdAt        DateTime       @default(now())
}

// AI generirani nacrt ponude za projekt, izvezen kao .docx
model GeneratedOffer {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  createdAt    DateTime @default(now())
}

// Tvrtka konkurent koju korisnik želi pratiti
model Competitor {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())

  awards CompetitorAward[]
}

// Javno dostupan podatak o dodjeli ugovora (iz EOJN RH / TED obavijesti o dodjeli, ili ručno/CSV uvezen)
model CompetitorAward {
  id           String      @id @default(cuid())
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  winnerName   String // naziv ponuditelja koji je dobio ugovor (ako ne odgovara praćenom konkurentu)
  authority    String?
  cpv          String?
  tenderTitle  String
  value        Float?
  currency     String      @default("EUR")
  awardDate    DateTime?
  productsText String? // opis proizvoda/usluga/stavki iz dodjele, slobodan tekst
  sourceType   String      @default("manual") // eojn | ted | manual
  sourceUrl    String?
  createdAt    DateTime    @default(now())
}

// Kriteriji po kojima automatska pretraga filtrira nove natječaje na TED / EOJN RH (jedan singleton red)
model SearchProfile {
  id          String   @id @default(cuid())
  cpvCodes    String? // CPV kodovi odvojeni zarezom, npr. "30190000,79800000"
  keywords    String? // ključne riječi odvojene zarezom
  minValue    Float?
  maxValue    Float?
  county      String? // lokacija / regija naručitelja
  sourceTed   Boolean  @default(true)
  sourceEojn  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Natječaj pronađen automatskom pretragom na TED-u ili EOJN RH
model TenderListing {
  id             String    @id @default(cuid())
  source         String // ted | eojn
  externalId     String // jedinstveni ID obavijesti kod izvora
  title          String
  authority      String?
  cpv            String?
  publishedDate  DateTime?
  deadline       DateTime?
  estimatedValue Float?
  currency       String    @default("EUR")
  noticeType     String? // notice | award
  url            String?
  rawExcerpt     String? // isječak sirovog odgovora izvora, za dijagnostiku mapiranja polja
  createdAt      DateTime  @default(now())

  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
}
