# Coinbase Advanced Trade API (CDP API Key) - samo za autenticirane pozive (stanje računa, naloge).
# Napravi ga na portal.cdp.coinbase.com s dopuštenjem "trade" - NIKAD "transfer"/"withdraw".
# Bez ovoga i dalje rade backtest, usporedba strategija i paper trading (koriste javni feed).
COINBASE_API_KEY_NAME=""
COINBASE_API_PRIVATE_KEY=""

# Sigurnosna kočnica za pravo trgovanje. Ostavi na "false" dok ne završiš paper trading fazu i
# svjesno odlučiš preuzeti rizik pravog novca.
LIVE_TRADING_ENABLED=false

# Najviše EUR koje jedan "buy" live nalog smije potrošiti.
LIVE_MAX_POSITION_EUR=0

# Ako dnevni gubitak premaši ovaj iznos, zaustavi se (trenutno samo kao referenca - provjeri
# README prije nego se osloniš na ovo u produkciji).
LIVE_DAILY_LOSS_LIMIT_EUR=0

PAPER_STARTING_BALANCE_EUR=500
