# NAPOMENA (KriptoMVP 4.4): aplikacija je isključivo savjetnik/simulator. Namjerno nema
# konfiguracije za Coinbase trgovačke (autenticirane) API ključeve niti za pravo trgovanje - taj
# kod je uklonjen. Koristi se samo javni, read-only Coinbase cjenovni feed (bez ključa).

PAPER_STARTING_BALANCE_EUR=500

# Opcionalno - makro/sentiment izvori (dashboard odjeljak "Makro, sentiment i regulativa").
# Bez ovih ključeva ti izvori samo neće raditi, ostatak aplikacije radi normalno.
# FRED - besplatan ključ: fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""
# Reddit - besplatna registracija "script" aplikacije: reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# GitHub - opcionalno (bez njega 60 zahtjeva/sat, dovoljno za povremeni sync). Besplatan Personal
# Access Token (classic, bez posebnih dopuštenja): github.com/settings/tokens
GITHUB_TOKEN=""
# CryptoPanic - besplatan tier, registracija: cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=""
